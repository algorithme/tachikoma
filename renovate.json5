// managed-by: update-manager#f34a31281c895d8ad98a6140e459af8414e27eec0a27f443fb361f916407d286
// Generated by /renovate-sync from inventory.md and update-manager.constraints.yml.
// Regenerate with /renovate-sync; custom package rules belong in the region below.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  gitAuthor: 'olivier morel <algorithme@users.noreply.github.com>',
  extends: ['config:recommended'],
  enabledManagers: ['cargo', 'npm', 'github-actions'],
  branchPrefix: 'deps/',
  dependencyDashboard: true,

  // Renovate waits for passing checks before merging on a subsequent run.
  platformAutomerge: false,

  vulnerabilityAlerts: {
    enabled: true,
    labels: ['security'],
  },

  packageRules: [
    {
      description: 'Automerge patch, digest, pin, and lockfile updates',
      matchUpdateTypes: ['patch', 'digest', 'pin', 'lockFileMaintenance'],
      automerge: true,
    },
    {
      description: 'Require dashboard approval for major bumps; handle with /update-manager',
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
      automerge: false,
      labels: ['needs-update-manager'],
    },
    {
      description: 'Open PRs for minor bumps without automerge unless opted in below',
      matchUpdateTypes: ['minor'],
      automerge: false,
    },
    {
      description: 'User opt-in (inventory.automerge_minor): automerge minor for rust',
      matchManagers: ['cargo'],
      matchUpdateTypes: ['minor'],
      automerge: true,
    },
    {
      description: 'User opt-in (inventory.automerge_minor): automerge minor for node',
      matchManagers: ['npm'],
      matchUpdateTypes: ['minor'],
      automerge: true,
    },
    {
      description: 'User opt-in (inventory.automerge_minor): automerge minor for github-actions',
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor'],
      automerge: true,
    },

    // Match ordinary updates so lockfile maintenance keeps Renovate's own title.
    {
      matchManagers: ['cargo'],
      matchUpdateTypes: ['major', 'minor', 'patch', 'pin', 'digest'],
      commitMessagePrefix: 'deps(rust):',
    },
    {
      matchManagers: ['npm'],
      matchUpdateTypes: ['major', 'minor', 'patch', 'pin', 'digest'],
      commitMessagePrefix: 'deps(node):',
    },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['major', 'minor', 'patch', 'pin', 'digest'],
      commitMessagePrefix: 'deps(github-actions):',
    },

    // region: user-managed
    // Add custom packageRules here. /renovate-sync preserves this block.
    // endregion: user-managed
  ],
}
